# Copy this file to .env and fill in your own values. Never commit .env.

# Database: PostgreSQL. Locally it runs in Docker (the start script starts it); online use Neon or similar.
# Optional no-Docker quick start: ./apply-fix.sh --sqlite  (writes sqlite:///.../adbanao.db here)
DATABASE_URL=postgresql://adbanao:adbanao@localhost:5432/adbanao

# LLM providers (free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=
# Model names change when providers retire models. See docs/28-api-conventions.md before changing.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# App
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
FRONTEND_ORIGIN=http://localhost:5173

# Storage for uploaded product images and exported ads.
# local = a folder on this computer (development). s3 = a bucket such as Cloudflare R2 (online; required there).
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# Only with STORAGE_BACKEND=s3 (R2 endpoint looks like https://<account id>.r2.cloudflarestorage.com):
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Admins (development and test only): emails that become admins when they sign up or sign in.
# In production this list is ignored; use the command line instead (see docs/22-admin.md).
ADMIN_EMAILS=
# Format: email=secretword, comma separated. Example: ADMIN_EMAILS=admin@demo.adbanao.test=banao-demo-secret

# Local admin login used by start-adbanao.sh. Leave these blank: the first start makes random ones here.
# Never commit real values. (This file is only a template; your own .env is git-ignored.)
ADBANAO_ADMIN_EMAIL=
ADBANAO_ADMIN_PASSWORD=
ADBANAO_ADMIN_SECRET=
